+		private void BalanceAiBudget(GameData gameData) {
+			while (gold + CalculateGoldPerTurn() < 0) {
+				if (scienceRate > 0) {
+					--scienceRate;
+					++taxRate;
+				} else if (luxuryRate > 0) {
+					--luxuryRate;
+					++taxRate;
+				} else if (TotalUnitsAllowedUnitsAndSupportCost().Item3 > 0
+					&& (LeastUsefulUnit(spareCivilians: true) ?? LeastUsefulUnit(spareCivilians: false)) is MapUnit unit) {
