@@ -0,0 +1,48 @@
+using System;
+using C7Engine;
+
+namespace C7GameData;
+
+// Upgrading a unit in place, as in Civilization III: in one of its owner's cities, to the best unit along its
+// upgrade chain that city can build, for gold. It keeps its id, experience, hit points and position, and uses up
+// its moves for the turn.
+public partial class MapUnit {
+	/// <summary>The owner's city on this unit's tile, where it may upgrade, or null.</summary>
+	public City UpgradeCity() {
+		return location?.cityAtTile is City city && city.owner == owner ? city : null;
+	}
+
+	/// <summary>What this unit would upgrade to where it stands, or null.</summary>
+	public UnitPrototype UpgradeTarget() {
+		City city = UpgradeCity();
+		return city == null ? null : unitType.UpgradeTargetIn(city, city.GetAccessibleResources(EngineStorage.gameData));
+	}
+
+	/// <summary>The gold an upgrade to `target` costs: the shield difference (at least 1) times the rule's rate.</summary>
+	public int UpgradeCost(UnitPrototype target) {
+		return Math.Max(1, target.shieldCost - unitType.shieldCost) * EngineStorage.gameData.rules.UpgradeCostPerShield;
+	}
+
+	public bool CanUpgrade() {
+		UnitPrototype target = UpgradeTarget();
+		return target != null && movementPoints.canMove && owner.gold >= UpgradeCost(target);
+	}
+
+	/// <summary>Upgrades the unit if it can; returns the gold it cost, or 0 when it could not.</summary>
+	public int Upgrade() {
+		if (!CanUpgrade()) {
+			return 0;
+		}
+		UnitPrototype target = UpgradeTarget();
+		int cost = UpgradeCost(target);
+		owner.gold -= cost;
+		if (name == unitType.name) {
+			name = target.name;
+		}
+		unitType = target;
+		hitPointsRemaining = Math.Min(hitPointsRemaining, maxHitPoints);
+		movementPoints.onConsumeAll();
+		path = null;
+		return cost;
+	}
+}
