-					await PlayerAI.PlayTurn(player, gameData);
+				// One AI's bug must neither abort everyone else's moves nor stall
+				// the game on this turn forever: log it and end that player's turn.
+				try {
+					if (player.isBarbarians) {
+						await BarbarianAI.PlayTurn(player, gameData);
