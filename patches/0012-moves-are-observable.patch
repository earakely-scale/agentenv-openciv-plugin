 using static C7GameData.PlayerRelationship;
 
 namespace C7GameData {
+	/// <summary>
+	/// Follows units as they move, a tile at a time, for a UI with no animation messages to follow (the engine sends none
+	/// while animations are off). Calls are synchronous. An observer must not change game state or draw from
+	/// GameData.rng.
+	/// </summary>
+	public interface IMoveObserver {
+		/// <summary>The unit has stepped from one tile to the next (MapUnit.Move: a move, the last step of a won attack, or
+		/// a retreat), before it enters the new tile (OnEnterTile: a city it takes, a hut it opens). Units carried aboard
+		/// move with their transport and are not reported.</summary>
+		void UnitMoved(MapUnit unit, Tile from, Tile to);
+	}
+
