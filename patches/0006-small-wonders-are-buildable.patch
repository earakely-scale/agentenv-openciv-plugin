+		// A small wonder is built once per civilization, by one city at a time.
+		private bool CanProduceSmallWonder(City city) {
+			foreach (City c in city.owner.cities) {
+				if (c.GetBuildings().Exists(cityBuilding => cityBuilding.building == this)) {
+					return false;
+				}
+				if (c != city && c.itemBeingProduced != null && c.itemBeingProduced.name == name) {
+					return false;
+				}
+			}
+
+			// Civ III gates the small wonders that need no tech, building or
+			// resource here (Heroic Epic, The Pentagon) on armies, which the
+			// engine does not have yet.
+			if (requiredTech == null && requiredBuilding == null && requiredResources.Count == 0 && !isForbiddenPalace) {
+				return false;
+			}
+
+			// A second seat of government belongs away from the first.
+			if (isForbiddenPalace && city.GetBuildings().Exists(cb => cb.building.isCenterOfEmpire || cb.building.isForbiddenPalace)) {
+				return false;
+			}
+
+			return true;
+		}
