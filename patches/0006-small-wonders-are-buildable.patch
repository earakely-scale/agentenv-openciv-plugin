+			// A forbidden palace pays off in a city that loses a lot to
+			// corruption, i.e. one far from the palace.
+			if (building.isForbiddenPalace) {
+				score += (city.CurrentProductionYield().corrupt + city.CurrentCommerceYield().corrupted) * 2;
+			}
