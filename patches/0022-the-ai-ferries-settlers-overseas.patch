+namespace C7GameData.AIData {
+	public class FerryAIData : UnitAIData {
+		// The overseas settler the ship carries, or null to put whoever is
+		// aboard ashore at `port` or, failing a port, at `landing`.
+		public MapUnit settler;
+		public Tile port = Tile.NONE;
+		// The water tile next to the land where the cargo goes ashore.
+		public Tile landing = Tile.NONE;
+		public TilePath path;
+		// The cargo is aboard and the ship heads for `landing`.
+		public bool sailing;
+		// The ship is at `landing` and waits for its cargo to step ashore,
+		// since this turn.
+		public int unloadingSince = -1;
+
+		public override string ToString() {
+			string cargo = settler == null ? "cargo" : "settler " + settler.id;
+			return unloadingSince >= 0 ? $"putting {cargo} ashore at {landing}" : sailing ? $"carrying {cargo} to {landing}" : $"fetching {cargo} at {port}";
+		}
+	}
+}
