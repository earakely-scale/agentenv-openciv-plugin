+using C7GameData.AIData;
+using Serilog;
+
+namespace C7Engine {
+	/// <summary>
+	/// A ship that carries units: it fetches a settler waiting in port for a
+	/// ship (SettlerAI, overseas) with its escort, sails to a landing next to
+	/// the settler's site and waits there while they step ashore. A ship found
+	/// with cargo and no plan (after a load, or a plan that failed) finishes
+	/// the crossing of the overseas settler aboard, or else takes its cargo to
+	/// the nearest of our ports and puts it ashore.
+	/// </summary>
+	public class FerryAI : UnitAI {
+		private static ILogger log = Log.ForContext<FerryAI>();
+		public FerryAIData data;
+
+		// Turns a ship waits at a landing for its cargo to step ashore, before
+		// it takes whoever is left back to port.
+		private const int UNLOAD_TURNS = 3;
+
+		public FerryAI(FerryAIData d) {
+			data = d;
+		}
+
+		/// <summary>Whether ships could carry a settler for this player: it has one that can, or can build one, and has a port on the ocean.</summary>
+		public static bool CanGetTransport(Player player) {
+			bool ship = player.units.Any(u => u.CanTransport())
+				|| EngineStorage.gameData.unitPrototypes.Any(t => IsTransport(t) && t.producibleBy.Contains(player.civilization) && player.HasRequiredTechnology(t));
+			return ship && player.cities.Any(c => c.location.NeighborsOcean());
+		}
+
+		public static bool IsTransport(UnitPrototype t) {
+			return t.IsSeaUnit() && t.capacity > 0 && t.actions.Contains(UnitAction.Unload);
+		}
+
+		public static List<MapUnit> Cargo(MapUnit ship) {
+			return ship.location.unitsOnTile.Where(u => u != ship && u.IsLoadedIn(ship)).ToList();
+		}
+
+		/// <summary>
+		/// Whether a passenger stays aboard, fortified, this turn: until its ship
+		/// is at a landing putting its cargo ashore, or in one of our cities. At
+		/// sea a passenger has nothing to do, and re-planning there could only fail.
+		/// </summary>
+		public static bool StaysAboard(MapUnit passenger) {
+			MapUnit ship = passenger.location.unitsOnTile.FirstOrDefault(u => passenger.IsLoadedIn(u));
+			if (ship == null || passenger.location.HasCity()) {
+				return false;
+			}
+			return !(ship.currentAI is FerryAI ferry && ferry.data.unloadingSince >= 0 && ship.location == ferry.data.landing);
+		}
+
+		// Overseas settlers that wait for a ship: none has the job, or the one
+		// that had it was lost or has another plan.
+		private static IEnumerable<(MapUnit settler, SettlerAI ai)> Waiting(Player player) {
+			foreach (MapUnit u in player.units) {
+				if (u.currentAI is SettlerAI s && s.data.overseas && !u.IsLoaded() && !HasFerry(s)) {
+					yield return (u, s);
+				}
+			}
+		}
+
