+			}
+
+			// Fetch a settler waiting at a port on our waters.
+			HashSet<int> waters = ExplorerAI.WaterBodies(ship.location);
+			foreach ((MapUnit settler, SettlerAI s) in Waiting(player)) {
+				if (SettlerLocationAI.OceanBodies(s.data.port).Overlaps(waters)) {
+					s.data.ferry = ship;
+					log.Information($"{ship} will ferry {settler} from {s.data.port} to {s.data.destination}");
+					return new FerryAIData { settler = settler, port = s.data.port };
+				}
+			}
+			return null;
+		}
+
+		// A plan to put the cargo ashore: in the nearest of our ports the ship
+		// can reach, or else on the nearest shore it can reach.
+		private static FerryAIData Ashore(MapUnit ship, Player player) {
+			PathingAlgorithm algorithm = PathingAlgorithmChooser.GetAlgorithm(ship);
+			HashSet<int> waters = ExplorerAI.WaterBodies(ship.location);
+			if (ship.location.HasCity()) {
+				return new FerryAIData { port = ship.location };
+			}
+			foreach (City c in player.cities.Where(c => ExplorerAI.WaterBodies(c.location).Overlaps(waters)).OrderBy(c => c.location.DistanceTo(ship.location)).Take(3)) {
+				TilePath path = algorithm.PathFrom(ship.location, c.location, ship);
+				if (path.PathLength() > 0) {
+					return new FerryAIData { port = c.location, path = path };
+				}
+			}
+			Tile shore = NearestShore(ship, player);
+			return shore == Tile.NONE ? null : new FerryAIData { landing = shore, sailing = true };
+		}
+
+		// The nearest water tile on the ship's waters, its own tile first, next
+		// to land the cargo can step onto (no city, no foreign unit), that the
+		// ship can reach. With no port left on its waters (all lost, or the
+		// civ has none) this is where the cargo goes ashore.
+		private static Tile NearestShore(MapUnit ship, Player player) {
+			PathingAlgorithm algorithm = PathingAlgorithmChooser.GetAlgorithm(ship);
+			HashSet<Tile> seen = new() { ship.location };
+			Queue<Tile> frontier = new(seen);
+			int tried = 0;
+			while (frontier.Count > 0 && tried < 4) {
+				Tile t = frontier.Dequeue();
+				if (t.unitsOnTile.All(u => u.owner == player)
+					&& t.neighbors.Values.Any(n => n != Tile.NONE && n.IsLand() && !n.HasCity() && n.unitsOnTile.All(u => u.owner == player))) {
+					if (t == ship.location || algorithm.PathFrom(ship.location, t, ship).PathLength() > 0) {
+						return t;
+					}
+					++tried;
+				}
+				foreach (Tile n in t.neighbors.Values) {
+					if (n != Tile.NONE && n.IsWater() && seen.Add(n)) {
+						frontier.Enqueue(n);
+					}
+				}
+			}
+			return Tile.NONE;
+		}
+
+		/// <summary>
+		/// Where a ship puts a settler ashore for a site: a water tile on its
+		/// waters within three tiles of the site, next to the site's landmass,
+		/// with no foreign unit on it, the nearest the site it can reach.
+		/// </summary>
+		public static Tile Landing(Tile site, MapUnit ship) {
+			HashSet<int> waters = ExplorerAI.WaterBodies(ship.location);
+			PathingAlgorithm algorithm = PathingAlgorithmChooser.GetAlgorithm(ship);
+			IEnumerable<Tile> landings = site.GetTilesWithinRankDistance(3)
+				.Where(t => t != Tile.NONE && t.IsWater() && waters.Contains(t.continent) && t.unitsOnTile.All(u => u.owner == ship.owner)
+					&& t.neighbors.Values.Any(n => n != Tile.NONE && n.IsLand() && n.continent == site.continent))
+				.OrderBy(t => t.DistanceTo(site));
+			foreach (Tile t in landings.Take(4)) {
+				if (t == ship.location || algorithm.PathFrom(ship.location, t, ship).PathLength() > 0) {
+					return t;
+				}
+			}
+			return Tile.NONE;
+		}
+
+		public void UpdateOnDeath() {
+			if (data.settler?.currentAI is SettlerAI s && s.data.ferry != null && s.data.ferry.currentAI == this) {
+				s.data.ferry = null;
+			}
+		}
+
+		public string SummarizePlan() {
+			return "FerryAI: " + data;
+		}
+
+		// The settler's plan still needs this ship.
+		private bool SettlerNeedsUs() {
+			return data.settler != null && data.settler.hitPointsRemaining > 0 && data.settler.currentAI is SettlerAI s
+				&& (s.data.overseas || (s.data.landed && data.settler.IsLoaded()));
+		}
+
+		// Moves along the path to `to`, finding one first; Error if there is no route.
+		private UnitAI.MoveResult SailTo(MapUnit ship, Tile to) {
+			if (data.path == null || data.path.destination != to || data.path.PathLength() <= 0) {
+				data.path = PathingAlgorithmChooser.GetAlgorithm(ship).PathFrom(ship.location, to, ship);
+				if (data.path.PathLength() <= 0) {
+					log.Information($"{ship} has no route from {ship.location} to {to}");
+					return UnitAI.Result.Error;
+				}
+			}
+			return this.TryToMoveAlongPath(ship, ref data.path);
+		}
+
+		// Every branch moves the ship, spends its moves or ends the plan, so
+		// UnitAI.PlayTurn never spins.
+		UnitAI.MoveResult UnitAI.PlayTurnImpl(Player player, MapUnit ship) {
+			List<MapUnit> cargo = Cargo(ship);
+			if (data.unloadingSince >= 0) {
+				// At the landing: wait while the cargo steps ashore, a few turns at most.
+				if (cargo.Count == 0) {
+					return UnitAI.Result.Done;
+				}
+				if (EngineStorage.gameData.turn - data.unloadingSince >= UNLOAD_TURNS) {
+					log.Information($"{ship} gives up landing {cargo.Count} units at {ship.location}");
+					if (data.settler?.currentAI is SettlerAI s && data.settler.IsLoaded()) {
+						s.data.landed = false;
+					}
+					return UnitAI.Result.Error;
+				}
+				ship.movementPoints.onConsumeAll();
+				return UnitAI.Result.InProgress;
+			}
+			if (data.settler == null && cargo.Count == 0) {
+				return UnitAI.Result.Done;
+			}
+			if (data.settler != null && !SettlerNeedsUs()) {
+				// The settler was lost or has another plan: put whoever is aboard ashore.
+				if (cargo.Count == 0) {
+					return UnitAI.Result.Error;
+				}
+				FerryAIData ashore = Ashore(ship, player);
+				if (ashore == null) {
+					return UnitAI.Result.Error;
+				}
+				data = ashore;
+			}
+			SettlerAI settlerAi = data.settler?.currentAI as SettlerAI;
+
+			if (!data.sailing) {
+				if (ship.location != data.port) {
+					return SailTo(ship, data.port);
+				}
+				if (data.settler == null) {
+					// Home with no plan: everyone goes ashore in port.
+					foreach (MapUnit u in cargo) {
+						u.UnboardTransport(ship);
+					}
+					return UnitAI.Result.Done;
+				}
+				if (data.settler.location != data.port || !settlerAi.data.overseas) {
+					// Wait in port for the settler.
+					ship.movementPoints.onConsumeAll();
+					return UnitAI.Result.InProgress;
+				}
+				foreach (MapUnit u in new[] { data.settler, settlerAi.data.escort }) {
+					if (u != null && u.hitPointsRemaining > 0 && u.location == ship.location && !u.IsLoaded() && ship.FreeCapacity() > 0) {
+						u.BoardTransport(ship);
+					}
+				}
+				data.landing = Landing(settlerAi.data.destination, ship);
+				if (data.landing == Tile.NONE) {
+					log.Information($"{ship} finds no landing for {settlerAi.data.destination}");
+					foreach (MapUnit u in Cargo(ship)) {
+						u.UnboardTransport(ship);
+					}
+					settlerAi.data.overseas = false;
+					return UnitAI.Result.Error;
+				}
+				data.sailing = true;
+				data.path = null;
+				log.Information($"{ship} sails from {ship.location} with {Cargo(ship).Count} units for {data.landing}");
+			}
+
+			if (ship.location != data.landing) {
+				return SailTo(ship, data.landing);
+			}
+
+			// Arrived: wake the cargo, which steps ashore on its own turns; the
+			// settler walks to its site without waiting for an escort.
+			foreach (MapUnit u in Cargo(ship)) {
+				u.Wake();
+			}
+			if (settlerAi != null) {
+				settlerAi.data.overseas = false;
+				settlerAi.data.landed = true;
+				settlerAi.data.ferry = null;
+				settlerAi.data.pathToDestination = PathingAlgorithmChooser.GetAlgorithm(data.settler).PathFrom(ship.location, settlerAi.data.destination, data.settler);
+			}
+			data.unloadingSince = EngineStorage.gameData.turn;
+			ship.movementPoints.onConsumeAll();
+			return UnitAI.Result.InProgress;
+		}
+	}
