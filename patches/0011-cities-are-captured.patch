+		// A city taken in war changes hands, as in Civilization III: it loses a
+		// citizen, and a city of size 1 is destroyed instead. Its palace and
+		// small wonders, which belong to the civ that built them, are lost; its
+		// great wonders and other buildings stay. The production and food boxes
+		// empty and the new owner picks what to build. The old owner's units
+		// still in the city are lost, as when a city is destroyed. The citizens
+		// keep their nationality and work the new owner's tiles, and the borders
+		// follow the new owner's culture in the city.
+		public static void CaptureCity(City city, Player conqueror) {
+			if (city.residents.Count <= 1) {
+				DestroyCity(city);
+				return;
+			}
+			GameData gameData = EngineStorage.gameData;
+			Player loser = city.owner;
+
+			city.location.DisbandNonDefendingUnits(loser);
+
+			// What the city owned under its old owner (its borders, and the
+			// fringe Laws VII and VIII add), cleared below so the borders are
+			// recomputed for the new owner.
+			List<Tile> oldBorders = city.GetTilesWithinBorders();
+			HashSet<ID> oldBorderIds = oldBorders.Select(x => x.Id).ToHashSet();
+			List<Tile> oldFringe = oldBorders.SelectMany(t => t.GetEdgeNeighbors())
+				.Where(t => !oldBorderIds.Contains(t.Id) && !t.HasCity() && t.owningCity == city).Distinct().ToList();
+
+			List<Civilization> nationalities = city.residents.Select(r => r.nationality).ToList();
+			nationalities.RemoveAt(nationalities.Count - 1);
+			city.RemoveAllCitizens();
+
+			city.capital = false;
+			city.constructed_buildings.RemoveAll(cb => cb.building.isCenterOfEmpire || cb.building.isSmallWonder);
+			city.SetStoredShields(0);
+			city.foodStored = 0;
+			city.isInCivilDisorder = false;
+			city.turnsOfUnhappinessDueToPopRushing = 0;
+
+			loser.cities.Remove(city);
+			conqueror.cities.Add(city);
+			city.owner = conqueror;
+			city.perPlayerCulture.TryAdd(conqueror, 0);
+
+			// Residents before tile owners: a city with no residents counts as
+			// destroyed (GameData.UpdateTileOwners).
+			CitizenType laborer = gameData.citizenTypes.Find(x => x.IsDefaultCitizen);
+			foreach (Civilization nationality in nationalities) {
+				city.AddCitizen(new CityResident { citizenType = laborer, nationality = nationality, city = city });
+			}
+
+			foreach (Tile t in oldBorders.Concat(oldFringe)) {
+				if (t.owningCity == city) {
+					t.owningCity = null;
+				}
+			}
+			gameData.UpdateTileOwners();
+
+			// As when a city is built: the trade network first (assigning tiles
+			// needs the luxuries), then the citizens, then production.
+			gameData.InvalidateCachedTradeNetwork();
+			foreach (CityResident resident in city.residents.ToList()) {
+				CityTileAssignmentAI.AssignNewCitizenToTile(gameData, resident);
+			}
+			city.SetItemBeingProduced(ChooseProducible.Choose(city, conqueror));
+
+			new MsgCityCaptured(city, loser).send();
+			gameData.CheckForCivDestructionAndNotifyUi(loser);
+
+			// Rank corruption depends on each civ's cities.
+			loser.DoCorruptionCalculations(gameData);
+			conqueror.DoCorruptionCalculations(gameData);
+		}
+
