+	/// <summary>
+	/// Follows battles as the engine fights them, round by round, for a UI with no animation messages to follow (the
+	/// engine sends none while animations are off) or a battle log. Calls are synchronous and nested only when a
+	/// retreat leads into another battle. An observer must not change game state or draw from GameData.rng.
+	/// </summary>
+	public interface ICombatObserver {
+		/// <summary>The rounds begin: an attack (MapUnit.Fight, after any defensive bombard) or a bombardment of a unit.</summary>
+		void CombatStarted(MapUnit attacker, MapUnit defender, bool bombard);
+
+		/// <summary>One round, or one bombard shot, and whether the attacker won it.</summary>
+		void CombatRound(MapUnit attacker, MapUnit defender, bool attackerWon);
+
+		/// <summary>The rounds are over and the hit points spent; the loser is not yet removed, nor the winner promoted.</summary>
+		void CombatEnded(MapUnit attacker, MapUnit defender);
+	}
+
 	public static class CombatResultExtensions {
 		public static bool AttackerWon(this CombatResult cR) {
 			return (cR == CombatResult.DefenderKilled) || (cR == CombatResult.DefenderRetreated);
