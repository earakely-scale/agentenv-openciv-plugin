+		/// <summary>The bodies of water a ship at this tile can sail: the one it is on, or in port those next to it.</summary>
+		public static HashSet<int> WaterBodies(Tile tile) {
+			if (tile.IsWater()) {
+				return new HashSet<int> { tile.continent };
+			}
+			return tile.neighbors.Values.Where(n => n != Tile.NONE && n.IsWater()).Select(n => n.continent).ToHashSet();
