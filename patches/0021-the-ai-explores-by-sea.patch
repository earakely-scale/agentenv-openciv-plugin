+		/// next to this port (lakes aside), so a ship built there would have
+		/// something to explore. Unlike MaybeMakeAiData it changes nothing.
+		/// </summary>
+		public static bool HasOceanToExplore(Player player, Tile port) {
+			HashSet<int> oceans = port.neighbors.Values.Where(n => n != Tile.NONE && n.IsWater() && !n.isFreshWater).Select(n => n.continent).ToHashSet();
+			return oceans.Count > 0 && player.tileKnowledge.borderTiles.Any(t => t.IsWater() && oceans.Contains(t.continent));
