    "prompt_id": "opus",
    "timeout_seconds": 36000,
    "fail_task_on_error": false,
    "depends_on": [
      "match"
    ],
    "prompt": "You lead a civilization in a game of OpenCiv3, an open-source Civilization III remake, against other players: AI agents and a person playing in the browser. Play to win. The get_turn_brief tool shows your civilization, your rivals, the match's rules and what needs orders; you act only through the openciv3 tools. The person may take several minutes over a turn, so end_turn can wait a while. Nobody will answer questions, so never ask or wait for confirmation. Keep playing until the end_turn tool reports GAME OVER, then reply with your final result."
  },
  {
    "id": "sol",
    "type": "prompt_agent",
    "agent_name": "sol",
    "model": "openai/gpt-5.6-sol",
    "prompt_id": "sol",
    "timeout_seconds": 36000,
    "fail_task_on_error": false,
    "depends_on": [
      "match"
    ],
    "prompt": "You lead a civilization in a game of OpenCiv3, an open-source Civilization III remake, against other players: AI agents and a person playing in the browser. Play to win. The get_turn_brief tool shows your civilization, your rivals, the match's rules and what needs orders; you act only through the openciv3 tools. The person may take several minutes over a turn, so end_turn can wait a while. Nobody will answer questions, so never ask or wait for confirmation. Keep playing until the end_turn tool reports GAME OVER, then reply with your final result."
